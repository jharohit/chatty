{
  "name": "chatty",
  "version": "1.0.8",
  "description": "A designer-grade, high-performance, privacy-first pastel multi-chat macOS app",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc && vite build",
    "build:electron": "node scripts/build-electron.cjs",
    "build": "npm run build:renderer && npm run build:electron",
    "app:dev": "node scripts/dev.cjs",
    "start": "electron .",
    "check": "tsc --noEmit",
    "dist": "npm run build && electron-builder --mac dmg",
    "dist:arm64": "npm run build && electron-builder --mac dmg --arm64",
    "dist:x64": "npm run build && electron-builder --mac dmg --x64",
    "release": "node scripts/release.cjs",
    "release:patch": "node scripts/release.cjs patch",
    "release:minor": "node scripts/release.cjs minor"
  },
  "build": {
    "appId": "com.chatty.app",
    "productName": "Chatty",
    "copyright": "Copyright © 2026 Chatty",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Chatty Installer",
      "icon": "build/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 200
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "keywords": [
    "chat",
    "whatsapp",
    "telegram",
    "signal",
    "slack",
    "macos",
    "electron",
    "pastel"
  ],
  "author": "Chatty",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
