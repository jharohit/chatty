{
  "name": "chatty",
  "version": "1.0.0",
  "description": "A designer-grade, high-performance, privacy-first pastel multi-chat macOS app",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "tsc && vite build",
    "build:electron": "node scripts/build-electron.cjs",
    "build": "npm run build:renderer && npm run build:electron",
    "app:dev": "node scripts/dev.cjs",
    "start": "electron .",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "chat",
    "whatsapp",
    "telegram",
    "signal",
    "slack",
    "macos",
    "electron",
    "pastel"
  ],
  "author": "Chatty",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
